# Copy to .env — every variable is prefixed WENSDAY_
WENSDAY_ENV=dev
WENSDAY_DATABASE_URL=sqlite+aiosqlite:///./wensday.db
# Production: postgresql+asyncpg://wensday:password@postgres:5432/wensday
# WENSDAY_REDIS_URL=redis://redis:6379/0
# WENSDAY_QDRANT_URL=http://qdrant:6333

# Auth — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
WENSDAY_JWT_SECRET=change-me-to-a-long-random-string
# Fernet key for OAuth tokens at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# WENSDAY_TOKEN_ENCRYPTION_KEY=
# WENSDAY_GOOGLE_CLIENT_ID=
# WENSDAY_GOOGLE_CLIENT_SECRET=
WENSDAY_WEB_ORIGIN=http://localhost:3000
WENSDAY_CORS_ORIGINS=["http://localhost:3000"]

# LLM failover chain (the rule-based offline engine is always the last resort)
WENSDAY_LLM_CHAIN=["anthropic","openai_compat","offline"]
# WENSDAY_ANTHROPIC_API_KEY=
# WENSDAY_ANTHROPIC_MODEL=claude-sonnet-5
# WENSDAY_OPENAI_API_KEY=
# WENSDAY_OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama / vLLM
# WENSDAY_OPENAI_MODEL=llama3.1

# Voice: "browser" = the client does STT/TTS (default). Server options: whisper | azure
WENSDAY_STT_PROVIDER=browser
WENSDAY_TTS_PROVIDER=browser
# WENSDAY_AZURE_SPEECH_KEY=
# WENSDAY_AZURE_SPEECH_REGION=centralindia
# WENSDAY_WHISPER_BASE_URL=http://localhost:9000/v1

WENSDAY_DEFAULT_TIMEZONE=Asia/Kolkata
